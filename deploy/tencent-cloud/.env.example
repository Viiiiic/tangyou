# 腾讯云后端域名，先把 A 记录指向 CVM 公网 IP。
DOMAIN=api.example.com

# 允许访问后端的 H5 来源。GitHub Pages 和本地调试都可以写，用逗号分隔。
ALLOWED_ORIGINS=https://viiiiic.github.io,http://localhost:4173

VISION_PROVIDER=minimax
MINIMAX_REGION=cn
MINIMAX_API_KEY=

TTS_MODE=minimax
MINIMAX_VOICE_ID="Chinese (Mandarin)_Kind-hearted_Antie"
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_SPEED=1.15

AUTH_REQUIRED=1
AUTH_INVITE_CODE=
AUTH_TOKEN_TTL_DAYS=30
